import java.util.*;

class Solution {
    public List<Integer> lastVisitedIntegers(int[] words) {
        List<Integer> nums = new ArrayList<>();
        List<Integer> ans = new ArrayList<>();
        int k = 0;

        for (int w : words) {
            if (w == -1) {  // assuming -1 represents "prev"
                k++;
                if (k > nums.size()) {
                    ans.add(-1);
                } else {
                    ans.add(nums.get(nums.size() - k));
                }
            } else {
                nums.add(w);
                k = 0;
            }
        }

        return ans;
    }
}
