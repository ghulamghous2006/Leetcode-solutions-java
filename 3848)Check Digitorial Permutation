import java.util.Arrays;

class Solution {
    public boolean isDigitorialPermutation(int n) {

        int original = n;
        int sum = 0;

        int[] fact = new int[10];
        fact[0] = 1;

        for(int i = 1; i <= 9; i++){
            fact[i] = fact[i-1] * i;
        }

        int temp = n;

        while(temp > 0){
            int digit = temp % 10;
            sum += fact[digit];
            temp /= 10;
        }

        String s1 = String.valueOf(original);
        String s2 = String.valueOf(sum);

        if(s1.length() != s2.length()) return false;

        char[] a = s1.toCharArray();
        char[] b = s2.toCharArray();

        Arrays.sort(a);
        Arrays.sort(b);

        return Arrays.equals(a, b);
    }
}
