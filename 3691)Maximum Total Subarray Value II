class Solution {
    public long maxTotalValue(int[] nums, int k) {
        int n = nums.length;

        long[] values = new long[n * (n + 1) / 2];
        int idx = 0;

        for (int i = 0; i < n; i++) {
            int mn = nums[i];
            int mx = nums[i];

            for (int j = i; j < n; j++) {
                mn = Math.min(mn, nums[j]);
                mx = Math.max(mx, nums[j]);
                values[idx++] = mx - mn;
            }
        }

        java.util.Arrays.sort(values);

        long ans = 0;
        for (int i = values.length - 1; i >= 0 && k > 0; i--, k--) {
            ans += values[i];
        }

        return ans;
    }
}
