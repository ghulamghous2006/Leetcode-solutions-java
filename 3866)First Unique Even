class Solution {
    public int firstUniqueEven(int[] nums) {
        int[] freq = new int[101]; // since 1 <= nums[i] <= 100

        // Count frequency
        for (int num : nums) {
            freq[num]++;
        }

        // Find first unique even
        for (int num : nums) {
            if (num % 2 == 0 && freq[num] == 1) {
                return num;
            }
        }

        return -1;
    }
}
