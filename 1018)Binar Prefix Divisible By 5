import java.util.*;

class Solution {
    public List<Boolean> prefixesDivBy5(int[] nums) {
        List<Boolean> result = new ArrayList<>();
        
        int current = 0; // stores remainder mod 5
        
        for (int num : nums) {
            current = (current * 2 + num) % 5;
            
            if (current == 0) {
                result.add(true);
            } else {
                result.add(false);
            }
        }
        
        return result;
    }
}
